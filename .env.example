# Copy to .env and fill in real values. Never commit .env.
# Explicit shell environment variables take precedence over this file.

# Anthropic Messages compatible endpoint (used by this project)
FDE_MODEL_PROTOCOL=anthropic
FDE_MODEL_URL=https://ark.cn-beijing.volces.com/api/coding
FDE_MODEL_NAME=deepseek-v4.1-flash
FDE_MODEL_KEY=replace-with-your-key
FDE_MODEL_TIMEOUT=90

# For a Chat Completions endpoint instead:
# FDE_MODEL_PROTOCOL=chat_completions
# FDE_MODEL_URL=https://your-endpoint.example.com/v1/chat/completions
